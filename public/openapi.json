{"openapi":"3.1.0","info":{"title":"GIT G.O.A.T. Readiness API","version":"1.0.0","description":"Public, read-only GitHub scan API. No repository code is executed. Private-repository access and GitHub writes are not enabled."},"servers":[{"url":"/api/v1"}],"paths":{"/health":{"get":{"summary":"Service health and capability flags","responses":{"200":{"description":"Live service capability report"}}}},"/scans":{"post":{"summary":"Scan a public GitHub repository at its current default-branch commit","description":"Read-only. Requires an https://github.com/owner/repo URL. Stores report in MongoDB if configured; otherwise stores it only in process memory.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["repository"],"properties":{"repository":{"type":"string","format":"uri","maxLength":500}}}}}},"responses":{"201":{"description":"Evidence-backed scan report"},"400":{"description":"Invalid request or URL"},"404":{"description":"Repository missing or not public"},"413":{"description":"Incomplete inventory refused"},"429":{"description":"GitHub API rate limit reached"}}}},"/scans/{id}":{"get":{"summary":"Retrieve a scan report","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Scan report"},"404":{"description":"Report not found or expired"}}}},"/scans/{id}/choices":{"post":{"summary":"Record a guided decision or justified scope exclusion","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["findingId","choice","rationale"],"properties":{"findingId":{"type":"string","maxLength":40},"choice":{"type":"string","maxLength":200},"rationale":{"type":"string","minLength":10,"maxLength":1000}}}}}},"responses":{"201":{"description":"Choice recorded with updated report"},"400":{"description":"Invalid choice or rationale"},"404":{"description":"Scan or finding not found"}}}}}}